# Gulf Breeze Air front-desk — server env vars (all optional; the server boots with none set)
# Copy to server/.env and fill in for a real deployment. Never commit .env.

# Port the HTTP/WS server listens on. Default 8080.
PORT=8080

# Public base URL of this deployment, e.g. https://gulfbreeze.up.railway.app
# Used to build the wss:// media-stream URL in the TwiML response.
# If unset, the request Host header is used (works locally behind tunnels).
PUBLIC_URL=

# OpenAI API key — required for the voice agent (Realtime API) and call summaries.
# Without it: /twilio/incoming still serves TwiML but the media-stream bridge
# hangs up politely, /api/realtime-token returns 503, summaries are skipped.
OPENAI_API_KEY=

# Realtime speech-to-speech model. Default gpt-realtime.
OPENAI_REALTIME_MODEL=gpt-realtime

# Model for the post-call summary + outcome classification. Default gpt-4o-mini.
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Twilio credentials (from the Twilio console).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Validate Twilio webhook signatures (X-Twilio-Signature) on /twilio/*.
# Effective only when TWILIO_AUTH_TOKEN is set. Set to "false" for local dev
# with a fake call simulator. Default true.
TWILIO_VALIDATE_SIGNATURE=true

# TEST ONLY: override the OpenAI Realtime WebSocket endpoint (used by the
# integration test's fake OpenAI server). Leave empty in real deployments.
OPENAI_REALTIME_WS_URL=

# Seed for the crew-line 4-digit PINs. PINs are derived deterministically per
# employee so they survive reseeds/redeploys; change the seed to rotate them all.
# The office looks them up with `npm --prefix server run pins`.
CREW_PIN_SEED=gba-crew-line-v1
